apiVersion: v1
baseDomain: {{ sno_base_domain }}
metadata:
  name: {{ sno_cluster_name }}
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: 1
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  replicas: 0
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
  machineNetwork:
  - cidr: 192.168.31.0/24
platform:
  none: {}
pullSecret: '{{ vault_openshift_pull_secret }}'
sshKey: '{{ vault_ssh_public_key }}'
